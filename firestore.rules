rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só a conta Google do dono (e-mail verificado) lê e grava, e apenas na própria pasta.
    // O script setup/configurar.sh troca __DONO_EMAIL__ pelo e-mail logado no Cloud Shell antes de publicar.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == "__DONO_EMAIL__";
    }
  }
}
